# ==========================================
# [바톤 Baton] 환경변수 템플릿
# ==========================================
# 이 파일을 복사해 '.env'를 만든 뒤 값을 채우세요. '.env'는 절대 커밋하지 않습니다.
# 비밀값은 팀 내부 채널로만 공유하고, CI/EC2용 값은 GitHub Secrets에 등록합니다.

# [A 파트 - BE 인증·보안]
JWT_SECRET_KEY=                       # 32바이트 이상 랜덤 문자열
JWT_ACCESS_EXPIRATION_MS=1800000      # 30분
JWT_REFRESH_EXPIRATION_MS=604800000   # 7일
CORS_ALLOWED_ORIGINS=http://localhost:5173

# [B 파트 - BE 도메인 & DB (MariaDB)]
SPRING_DATASOURCE_URL=jdbc:mariadb://mariadb:3306/baton_db
SPRING_DATASOURCE_USERNAME=baton_app  # 앱 전용 계정 (root 사용 금지)
SPRING_DATASOURCE_PASSWORD=
AI_BASE_URL=http://ai:8000            # Docker 내부 네트워크 주소
AI_TIMEOUT_MS=30000

# [B·D 공통 - Backend → AI 내부 인증]
AI_INTERNAL_API_KEY=                  # X-Internal-Api-Key 헤더 값

# [C 파트 - FE]
VITE_API_BASE_URL=/api                # Nginx가 /api를 Backend로 프록시

# [D·E 파트 - AI RAG]
LLM_API_KEY=
LLM_MODEL=                            # Day 1 팀 결정 후 기입
EMBEDDING_MODEL=                      # Day 1 팀 결정 후 기입
CHROMA_PERSIST_DIR=/data/chroma
CHROMA_COLLECTION=baton_docs
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# [F 파트 - MariaDB 컨테이너 초기화]
MARIADB_ROOT_PASSWORD=                # 컨테이너 초기화용, 앱에서 사용 금지
MARIADB_DATABASE=baton_db
MARIADB_USER=baton_app
MARIADB_PASSWORD=                     # SPRING_DATASOURCE_PASSWORD와 동일 값
