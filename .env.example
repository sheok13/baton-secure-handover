# ==========================================
# [Zero-Trust Whistleblower] 환경변수 템플릿
# ==========================================
# 주의: 이 파일을 복사해서 '.env' 파일을 만든 뒤 실제 값을 채워 넣으세요.
# '.env' 파일은 절대 깃(Git)에 커밋하면 안 됩니다.

# [A 파트 - BE 인증]
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# [B 파트 - BE 도메인 & DB]
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/baton_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
RESTCLIENT_AI_TIMEOUT_MS=30000

# [C 파트 - FE 프론트엔드]
VITE_API_BASE_URL=http://localhost:8080

# [D 파트 - AI RAG]
LLM_API_KEY=
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# [F 파트 - 클라우드 배포 전용]
# EC2_MYSQL_ROOT_PASSWORD= (GitHub Secrets에 등록할 운영용 비밀번호)
